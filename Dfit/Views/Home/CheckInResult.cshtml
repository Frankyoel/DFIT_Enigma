@{
    ViewData["Title"] = "Resultado Check-In";
}

<div class="mb-4">
    <h2>Control de Acceso</h2>
</div>

<div class="card text-center" style="max-width: 450px; margin: 0 auto; padding: 3rem 2rem;">
    @if (ViewBag.Success == true)
    {
        <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(99, 153, 34, 0.1); color: var(--primary); display: flex; justify-content: center; align-items: center; margin: 0 auto 1.5rem auto;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
        <h3 style="margin-bottom: 0.5rem; font-size: 22px;">¡Acceso Permitido!</h3>
    }
    else
    {
        <div style="width: 80px; height: 80px; border-radius: 50%; background: rgba(226, 75, 74, 0.1); color: var(--danger); display: flex; justify-content: center; align-items: center; margin: 0 auto 1.5rem auto;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </div>
        <h3 style="margin-bottom: 0.5rem; font-size: 22px;">Acceso Denegado</h3>
    }
    
    <p class="text-muted" style="line-height: 1.5; font-size: 15px; margin-bottom: 2rem;">@ViewBag.Message</p>
    
    <a href="/Home/Index" class="btn btn-secondary" style="width: 100%;">Ir a mi perfil</a>
</div>
