@model Dfit.Models.MembresiaUsuario
@{
    ViewData["Title"] = "Mi Membresía";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Mi Membresía</h2>
        <p class="text-muted" style="margin-top: 4px;">Consulta el estado de tu plan y fecha de renovación.</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8 col-lg-6">
        @if (Model != null)
        {
            <div class="card" style="padding: 24px; position: relative; overflow: hidden; border-top: 4px solid var(--primary);">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span class="badge" style="background: var(--primary); color: white; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600;">Vigente</span>
                    <span style="font-size: 13px; color: var(--text-muted);">ID: @Model.Id</span>
                </div>

                <h3 style="margin: 20px 0 8px 0; font-size: 22px;">@Model.Membresia?.Nombre</h3>
                <p class="text-muted" style="font-size: 14px; line-height: 1.6;">@Model.Membresia?.Descripcion</p>
                
                @if ((Model.FechaFin - System.DateTime.UtcNow).TotalDays <= 5)
                {
                    <div style="background: rgba(226, 75, 74, 0.15); border-left: 4px solid var(--danger); color: #FF9999; padding: 12px; border-radius: 6px; font-size: 13px; margin-top: 16px;">
                        <strong>¡Atención!</strong> Tu membresía vencerá en @Math.Max(0, (int)(Model.FechaFin - System.DateTime.UtcNow).TotalDays) días.
                    </div>
                }
                
                <div style="margin-top: 24px; display: flex; justify-content: space-between; font-size: 13px; border-top: 1px solid var(--border-color); padding-top: 16px;">
                    <div>
                        <div style="color: var(--text-muted); font-size: 12px;">Válido desde</div>
                        <strong style="font-size: 14px;">@Model.FechaInicio.ToString("dd/MM/yyyy")</strong>
                    </div>
                    <div style="text-align: right;">
                        <div style="color: var(--text-muted); font-size: 12px;">Vence el</div>
                        <strong style="font-size: 14px;">@Model.FechaFin.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>

                <div style="margin-top: 30px; display: flex; gap: 12px;">
                    <form asp-action="CancelMembresia" method="post" style="flex: 1;">
                        <input type="hidden" name="membresiaUsuarioId" value="@Model.Id" />
                        <input type="hidden" name="usuarioId" value="@Model.UsuarioId" />
                        <button type="submit" class="btn btn-danger" style="width: 100%;" onclick="return confirm('¿Seguro que deseas cancelar esta membresía?');">Cancelar Membresía</button>
                    </form>
                </div>
            </div>
            
            <div style="margin-top: 20px;">
                <a href="/Home/PagosUsuario/@Model.UsuarioId" class="btn btn-secondary">Ver mi historial de pagos →</a>
            </div>
        }
        else
        {
            <div class="card" style="padding: 40px; text-align: center;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; color: var(--text-muted); display: block; margin-left: auto; margin-right: auto;">
                    <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <h3 style="font-size: 18px; margin-bottom: 8px;">No tienes ninguna membresía activa</h3>
                <p class="text-muted" style="font-size: 14px;">Acércate a recepción o contacta al administrador para adquirir tu plan de entrenamiento.</p>
            </div>
        }
    </div>
</div>
