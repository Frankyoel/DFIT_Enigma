@{
    ViewData["Title"] = "Lector QR";
}

<div class="mb-4">
    <h2>Escanear Código QR</h2>
    <p class="text-muted" style="margin-top: 4px;">Utiliza tu teléfono para escanear y registrar tu asistencia.</p>
</div>

<div class="card text-center" style="max-width: 450px; margin: 0 auto; padding: 3rem 2rem;">
    <h3 style="color: var(--primary); margin-bottom: 0.5rem; font-size: 24px;">DFIT Power</h3>
    <p class="text-muted" style="margin-bottom: 2rem;">Apunta con la cámara de tu móvil para ingresar</p>
    
    <div id="qrcode" style="display: flex; justify-content: center; align-items: center; background: white; padding: 20px; border-radius: 12px; margin: 0 auto 2rem auto; width: fit-content; border: 1px solid var(--border-color);"></div>
    
    <div style="font-size: 14px; color: var(--text-muted); font-weight: 500;">
        El código se actualiza en <span id="countdown" style="color: var(--text-main); font-weight: bold;">60</span>s
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        var qrcode = new QRCode(document.getElementById("qrcode"), {
            width: 200,
            height: 200,
            colorDark : "#0a0a0a",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.H
        });

        let countdown = 60;
        let countdownEl = document.getElementById("countdown");

        function updateQR() {
            fetch('/Home/GenerarTokenQR')
                .then(response => response.json())
                .then(data => {
                    let fullUrl = window.location.origin + '/Home/CheckIn?token=' + data.token;
                    qrcode.clear();
                    qrcode.makeCode(fullUrl);
                    countdown = 60;
                });
        }

        setInterval(() => {
            countdown--;
            if (countdown <= 0) {
                updateQR();
            } else {
                countdownEl.innerText = countdown;
            }
        }, 1000);

        updateQR();
    </script>
}
