@model Dfit.Models.Membresia
@{
    ViewData["Title"] = "Crear Nuevo Plan";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Crear Nuevo Plan</h2>
        <p class="text-muted" style="margin-top: 4px;">Configura los detalles de un nuevo plan de membresía.</p>
    </div>
    <a href="/Home/Membresias" class="btn btn-secondary">← Volver</a>
</div>

<div class="card" style="max-width: 600px;">
    <form asp-action="CreateMembresia" method="post">
        <div class="form-group">
            <label asp-for="Nombre" class="form-label">Nombre del Plan</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej. Plan Mensual Básico" required />
        </div>
        
        <div class="form-group">
            <label asp-for="Descripcion" class="form-label">Descripción</label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Beneficios del plan..." required></textarea>
        </div>
        
        <div class="form-group">
            <label asp-for="Precio" class="form-label">Precio (S/)</label>
            <input asp-for="Precio" type="number" step="0.01" class="form-control" required />
        </div>
        
        <div class="form-group mb-4">
            <label asp-for="DuracionDias" class="form-label">Duración (días)</label>
            <input asp-for="DuracionDias" type="number" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%;">Guardar Plan</button>
    </form>
</div>
