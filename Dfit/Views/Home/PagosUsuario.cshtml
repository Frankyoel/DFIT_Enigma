@model IEnumerable<Dfit.Models.Pago>
@{
    ViewData["Title"] = "Historial de Pagos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Historial de Pagos</h2>
        <p class="text-muted" style="margin-top: 4px;">Comprobantes y registro de abonos realizados.</p>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="formal-table">
            <thead>
                <tr>
                    <th>Recibo #</th>
                    <th>Fecha</th>
                    <th>Concepto (Plan)</th>
                    <th>Método</th>
                    <th>Monto</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pago in Model)
                {
                    <tr>
                        <td style="color: var(--text-muted);">000-@pago.Id</td>
                        <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="font-weight: 600;">@(pago.Membresia?.Nombre ?? "Plan")</td>
                        <td>@pago.MetodoPago</td>
                        <td style="color: var(--primary); font-weight: 700;">S/ @pago.Monto.ToString("F2")</td>
                        <td><span class="badge" style="background: rgba(99,153,34,0.2); color: var(--primary); padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 600;">Completado</span></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 40px; color: var(--text-muted);">No tienes pagos registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
