resiaInactiva_DebeDenegarAcceso","objective":"Inactiva con fecha futura","input":"Activa=false; fin=new DateTime(2026, 10, 19, 12, 0, 0, DateTimeKind.Utc); ahora=2026-10-18T12:00:00Z","expected":"false","group":"Acceso"},{"id":"CP-ACC-004","method":"ValidarAcceso_EnInstanteExactoDeVencimiento_DebeDenegarAcceso","objective":"Vencimiento exacto","input":"Activa=true; fin=Ahora; ahora=2026-10-18T12:00:00Z","expected":"false","group":"Acceso"},{"id":"CP-ACC-005","method":"ValidarAcceso_UnTickAntesDeVencer_DebePermitirAcceso","objective":"Un tick antes de vencer","input":"Activa=true; fin=Ahora.AddTicks(1); ahora=2026-10-18T12:00:00Z","expected":"true","group":"Acceso"},{"id":"CP-ACC-006","method":"ValidarAcceso_UnTickDespuesDeVencer_DebeDenegarAcceso","objective":"Un tick después de vencer","input":"Activa=true; fin=Ahora.AddTicks(-1); ahora=2026-10-18T12:00:00Z","expected":"false","group":"Acceso"},{"id":"CP-PAG-001","method":"ExecutePayment_ConTarjeta_AplicaCincoPorCiento","objective":"Recargo de tarjeta","input":"200; estrategia tarjeta","expected":"210","group":"Pagos"},{"id":"CP-PAG-002","method":"ExecutePayment_ConEfectivo_NoAplicaRecargo","objective":"Efectivo sin recargo","input":"100; estrategia efectivo","expected":"100","group":"Pagos"},{"id":"CP-PAG-003","method":"ExecutePayment_SinEstrategia_UsaEfectivo","objective":"Estrategia predeterminada","input":"200; sin configurar estrategia","expected":"200","group":"Pagos"},{"id":"CP-PAG-004","method":"ExecutePaymentForAmount_MenorA100_UsaEfectivo","objective":"Selección por debajo del umbral","input":"99.99","expected":"99.99","group":"Pagos"},{"id":"CP-PAG-005","method":"ExecutePaymentForAmount_IgualA100_UsaEfectivo","objective":"Selección exactamente en el umbral","input":"100","expected":"100","group":"Pagos"},{"id":"CP-PAG-006","method":"ExecutePaymentForAmount_MayorA100_UsaTarjetaSinRedondeoAdicional","objective":"Selección por encima del umbral; conservar precisión actual","input":"100.01","expected":"105.0